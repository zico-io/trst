# ─────────────────────────────────────────────────────────────────────────────
# apps/web — local development
# Copy to .env.local and fill in values.
# Production vars are set automatically by `tofu apply` via the Vercel provider,
# except AUTH_GITHUB_ID and AUTH_GITHUB_SECRET (marked MANUAL below).
# ─────────────────────────────────────────────────────────────────────────────

# ── Required for all pages ────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trst_dev

# ── Required for /admin (login + session) ─────────────────────────────────────
# AUTH_SECRET: any random string locally. Production: tofu output -raw auth_secret
AUTH_SECRET=
# Vercel sets NEXTAUTH_URL automatically in production.
NEXTAUTH_URL=http://localhost:3000

# AUTH_GITHUB_ID / AUTH_GITHUB_SECRET  [MANUAL — not managed by tofu]
# Create a GitHub OAuth App at: github.com/settings/developers → OAuth Apps
#   Homepage URL:              http://localhost:3000
#   Authorization callback:   http://localhost:3000/api/auth/callback/github
# Use a separate OAuth App per environment (local / production).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Comma-separated GitHub logins allowed to reach /admin.
ADMIN_GITHUB_LOGINS=zico-io

# ── Required to trigger audits from /admin/repos ──────────────────────────────
# Production: tofu output agent_url  /  tofu output -raw agent_api_key
# Omitting AGENT_URL makes the "Run Audit" action throw; omit only if you won't
# use that button locally.
AGENT_URL=http://localhost:3001
AGENT_API_KEY=

# ── Optional: ISR revalidation ────────────────────────────────────────────────
# Only needed if you want the agent to trigger a cache revalidation on your local
# web instance. Returns 503 when unset but nothing else breaks.
# Production: tofu output -raw revalidate_secret
REVALIDATE_SECRET=

# ── Optional: OpenTelemetry ───────────────────────────────────────────────────
# Set automatically by `bun dev:observe` — no manual config needed for local dev.
# For production: set ENDPOINT to your OTLP collector and HEADERS to your ingest key.
# The HyperDX clickstack-otel-collector requires a raw token (no "Bearer " prefix):
#   OTEL_EXPORTER_OTLP_HEADERS=authorization=<hdx-team-api-key>
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-collector:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=<hdx-team-api-key>
# OTEL_SERVICE_NAME=trst-web
