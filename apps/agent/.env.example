# ─────────────────────────────────────────────────────────────────────────────
# apps/agent — local development
# Copy to .env and fill in values. Only DATABASE_URL is required.
# Production vars are injected by `tofu apply` via ECS task definition.
#
# LLM keys, GitHub App config, and issue backend are stored in the database —
# configure them via the /admin dashboard after first run, not here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trst_dev

# ── Optional: API auth ────────────────────────────────────────────────────────
# Leave unset to disable bearer auth entirely (fine for local dev).
# Production: tofu output -raw agent_api_key
AGENT_API_KEY=

# ── Optional: ISR revalidation ────────────────────────────────────────────────
# Leave both unset to skip revalidation (a warning is logged, nothing breaks).
# Production: tofu output -raw revalidate_secret  /  var.revalidate_url in tfvars
REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=

# ── Optional: GitHub issue backend ────────────────────────────────────────────
# Only needed when issue_backend = "github" is set in the admin dashboard.
GITHUB_OWNER=
GITHUB_REPO=

# ── Optional: server ──────────────────────────────────────────────────────────
# Defaults to 3001 if unset.
# PORT=3001

# ── Optional: OpenTelemetry ───────────────────────────────────────────────────
# Set automatically by `bun dev:observe` — no manual config needed for local dev.
# For production: set ENDPOINT to your OTLP collector and HEADERS to your ingest key.
# The HyperDX clickstack-otel-collector requires a raw token (no "Bearer " prefix):
#   OTEL_EXPORTER_OTLP_HEADERS=authorization=<hdx-team-api-key>
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=authorization=<hdx-team-api-key>
OTEL_SERVICE_NAME=trst-agent
