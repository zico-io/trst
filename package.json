{
  "name": "trst",
  "private": true,
  "packageManager": "bun@1.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "lefthook install",
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@trst/web",
    "dev:agent": "turbo dev --filter=@trst/agent",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/node": "^20",
    "lefthook": "^1.11.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
